# Supabase Configuration
# Copy this file to .env (in project root) and fill in your actual credentials
# Or use --dart-define flags when running the app

# Supabase URL (from Dashboard > Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (from Dashboard > Settings > API Keys)
# Supports both formats:
# - Legacy: anon key (starts with eyJ...)
# - New: publishable key (starts with sb_publishable_...)
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Sentry DSN (optional, for error tracking)
SENTRY_DSN=your_sentry_dsn_here
